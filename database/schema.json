{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dubai Streets Guide road database",
  "type": "object",
  "required": ["meta", "roads", "exit", "split", "uturn", "gas", "gate", "ra", "hub", "metro", "salik", "zones", "routes"],
  "$defs": {
    "latlng": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "lanes": {
      "type": "object", "required": ["total", "side", "dest"],
      "properties": {
        "total": { "type": "integer", "minimum": 1, "maximum": 8 },
        "side": { "enum": ["left", "right"] },
        "dest": { "type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["label", "hold", "kind"],
          "properties": { "label": { "type": "string" }, "hold": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 }, "kind": { "enum": ["exit", "through"] }, "note": { "type": "string" } } } }
      }
    },
    "point": {
      "type": "object", "required": ["id", "name", "lat", "lng"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "ar": { "type": "string" }, "lat": { "type": "number" }, "lng": { "type": "number" }, "road": { "type": "string" }, "km": { "type": "number" }, "tip": { "type": "string" }, "confidence": { "type": "string" }, "lanes": { "$ref": "#/$defs/lanes" } }
    }
  },
  "properties": {
    "meta": { "type": "object" },
    "roads": { "type": "array", "items": { "type": "object", "required": ["id", "name", "type", "limit", "coords"], "properties": { "type": { "enum": ["highway", "slip", "flyover", "loop"] }, "limit": { "type": "integer" }, "coords": { "type": "array", "items": { "$ref": "#/$defs/latlng" } } } } },
    "exit": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "split": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "uturn": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/point" }, { "required": ["type", "approach", "zone"], "properties": { "type": { "enum": ["loop", "signal", "ra"] }, "approach": { "type": "number" }, "approach_lane": { "enum": ["left", "right"] }, "zone": { "type": "string" } } }] } },
    "gas": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/point" }, { "required": ["brand"], "properties": { "brand": { "enum": ["ADNOC", "ENOC", "EMARAT"] }, "h24": { "type": "boolean" }, "ev": { "type": "boolean" }, "truck": { "type": "boolean" }, "prayer": { "type": "boolean" } } }] } },
    "gate": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "ra": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "hub": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "metro": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "salik": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "zones": { "type": "array", "items": { "type": "object", "required": ["id", "name", "coords"] } },
    "routes": { "type": "array", "items": { "type": "object", "required": ["id", "name", "steps"] } }
  }
}
